#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>

#include "positions_go60.dtsi"
#include "shared.dtsi"

/* ── Go60-specific: custom input processor + trackpad listeners ── */

/ {
    input_processors {
        zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_0 INPUT_BTN_1>;
        };
    };
};

/* Trackpad-activated Mouse layer (RH T1 = LCLK, RH T2 = RCLK).
 *
 * Tune the pre-defined &zip_temp_layer instance rather than declaring a
 * second one: the driver keeps its state on instance 0, so exactly one
 * instance must exist.
 *
 *   require-prior-idle-ms — don't grab the layer if a key was pressed in
 *     the last 200 ms, so brushing the pad mid-typing can't steal T1/T2.
 *   excluded-positions    — pressing anything NOT in this list drops the
 *     layer immediately; mods and the click keys stay in so that
 *     shift/cmd-click works.
 */
&zip_temp_layer {
    require-prior-idle-ms = <200>;
    excluded-positions = <MOUSE_KEEP_KEYS>;
};

/* Lower the right pad's ADC gain from the stock maximum ("1x" = most
 * sensitive). The pad's capacitive baseline drifts under sustained touch
 * and at max gain the drift shows up as a jumpy cursor until a no-touch
 * recalibration. "2x" matches MoErgo's "medium" sensitivity snippet.
 *
 * abs-mode switches the Pinnacle to absolute reporting for the raw touch
 * stream (see docs/raw-touch-protocol.md). Requires
 * CONFIG_ZMK_TOUCH_STREAM=y (go60_rh.conf): the touch-stream module turns
 * the absolute frames back into REL_X/REL_Y for normal pointing, so
 * without it the pad would stop moving the cursor. Note the pad's
 * hardware tap-to-click is a relative-mode feature and is lost here;
 * clicks come from RH T1/T2 on the Mouse layer as before. */
&glidepoint {
    sensitivity = "2x";
    abs-mode;
};

/* ── Override: right half is now central ── */
/* Remove device from cirque_split (central receives, doesn't send) */
&cirque_split {
    /delete-property/ device;
};

/* Enable listeners with swapped device assignments */
&cirque_lh_listener {
    status = "okay";
    device = <&cirque_split>;
    input-processors = <&zip_xy_scaler 3 1>, <&zip_button_behaviors>,
                       <&zip_temp_layer MOUSE_LAYER MOUSE_LAYER_MS>;
};

/* No nav_scroll override any more: scrolling on the Nav layer is now
 * synthesized on the host from the raw touch stream (vendor HID report,
 * see docs/raw-touch-protocol.md + the patched LinearMouse fork). While
 * the Nav layer is active the firmware withholds the pad's motion from
 * this listener entirely, so no wheel mapping is needed here.
 *
 * The base chain below only ever sees the REL_X/REL_Y deltas the
 * touch-stream module derives from the absolute frames (plus the ABS
 * frames themselves, which zip_xy_scaler/zip_button_behaviors ignore and
 * zip_temp_layer uses to keep the Mouse layer alive while touching). */
&cirque_rh_listener {
    status = "okay";
    device = <&glidepoint>;
    input-processors = <&zip_xy_scaler 3 1>, <&zip_button_behaviors>,
                       <&zip_temp_layer MOUSE_LAYER MOUSE_LAYER_MS>;
};
