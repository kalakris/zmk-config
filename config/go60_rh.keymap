#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <raw_touch/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/input_transform.h>

#include "positions_go60.dtsi"
#include "shared.dtsi"

/* ── Go60-specific: custom input processor + trackpad listeners ── */

/ {
    input_processors {
        zip_xy_to_vscroll_mapper: zip_xy_to_vscroll_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_REL>;
            map = <INPUT_REL_X INPUT_REL_WHEEL
                   INPUT_REL_Y INPUT_REL_WHEEL>;
        };

        zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_0 INPUT_BTN_1>;
        };
    };
};

/* Trackpad-activated Mouse layer (RH T1 = LCLK, RH T2 = RCLK).
 *
 * Tune the pre-defined &zip_temp_layer instance rather than declaring a
 * second one: the driver keeps its state on instance 0, so exactly one
 * instance must exist.
 *
 *   require-prior-idle-ms — don't grab the layer if a key was pressed in
 *     the last 200 ms, so brushing the pad mid-typing can't steal T1/T2.
 *   excluded-positions    — pressing anything NOT in this list drops the
 *     layer immediately; mods and the click keys stay in so that
 *     shift/cmd-click works.
 */
&zip_temp_layer {
    require-prior-idle-ms = <200>;
    excluded-positions = <MOUSE_KEEP_KEYS>;
};

/* Lower the right pad's ADC gain from the stock maximum ("1x" = most
 * sensitive). The pad's capacitive baseline drifts under sustained touch
 * and at max gain the drift shows up as a jumpy cursor until a no-touch
 * recalibration. "2x" matches MoErgo's "medium" sensitivity snippet.
 *
 * abs-mode switches the Pinnacle to absolute reporting for the raw touch
 * stream (see docs/raw-touch-protocol.md). Requires
 * CONFIG_ZMK_RAW_TOUCH=y (go60_rh.conf): the raw touch module turns
 * the absolute frames back into REL_X/REL_Y for normal pointing, so
 * without it the pad would stop moving the cursor.
 *
 * Tap-to-click and the pad's geometry now live on the raw_touch_rh node
 * below, not here: the module reads them from its own binding so it does
 * not depend on any particular trackpad driver. */
&glidepoint {
    /* MoErgo's Go60 board DTS sets these four on &glidepoint under the
     * forked driver's names. Zephyr 3.5's edtlib errors on properties a
     * binding does not declare, so they must be deleted before the
     * in-tree names are set. */
    /delete-property/ dr-gpios;
    /delete-property/ rotate-90;
    /delete-property/ y-invert;
    /delete-property/ no-secondary-tap;

    data-ready-gpios = <&go60_ext 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

    sensitivity = "2x";

    /* Absolute reporting, for the raw touch stream. */
    data-mode = "absolute";

    /* MANDATORY. Written to the Pinnacle's Z_IDLE register; upstream
     * DEFAULTS IT TO 0, which emits no lift-off packets at all - the
     * module would never see a release, so no release frame, no momentum
     * and no tap-to-click. The forked driver hardcoded 3 in absolute
     * mode. */
    idle-packets-count = <3>;

    /* Deliberately NOT setting swap-xy / invert-y here, unlike the left
     * pad below. Upstream applies invert-x/invert-y in BOTH modes (the
     * fork applied them in relative mode only), so setting invert-y would
     * bake the mirror into the streamed absolute frames. Frames must stay
     * raw: the orientation is declared on raw_touch_rh instead, where the
     * module applies it to the derived pointer deltas and publishes it in
     * the feature report for the host. swap-xy is inert in absolute mode
     * either way. */
};

/* The streaming pad. This node is what enables CONFIG_ZMK_RAW_TOUCH, and
 * it is the module's entire configuration surface - nothing about the
 * Cirque driver appears in it.
 *
 * rotate-90 / y-invert MUST match what the Go60 board DTS sets on
 * &glidepoint. Streamed frames go out untransformed and these bits are
 * published in the feature report so the host can apply them; they are
 * also applied to the relative deltas the module derives for the fallback
 * pointer path.
 *
 * tap-click is the firmware replacement for the pad's hardware
 * tap-to-click, which is a relative-mode feature and is lost in abs-mode.
 * Taps inject BTN_0 into this pad's listener chain, which must NOT contain
 * &zip_button_behaviors - that processor exists to map BTN_0 to &none (it
 * was added to mute the relative-mode hardware taps) and would eat the
 * firmware tap. With it removed, BTN_0 flows to the listener's native
 * button handling and clicks on any layer.
 * Defaults: 180 ms, 30 counts max movement - set tap-max-ms /
 * tap-max-movement to tune. */
/ {
    raw_touch_rh: raw_touch_rh {
        compatible = "zmk,raw-touch-pad";
        device = <&glidepoint>;
        pad-id = <0>;
        rotate-90;
        y-invert;
        tap-click;
    };
};

/* ── Override: right half is now central ── */
/* Remove device from cirque_split (central receives, doesn't send) */
&cirque_split {
    /delete-property/ device;
};

/* Enable listeners with swapped device assignments */
&cirque_lh_listener {
    status = "okay";
    device = <&cirque_split>;
    input-processors = <&zip_xy_scaler 3 1>, <&zip_button_behaviors>,
                       <&zip_temp_layer MOUSE_LAYER MOUSE_LAYER_MS>;
};

/* The base chain below sees the REL_X/REL_Y deltas the touch-stream
 * module derives from the absolute frames (plus the ABS frames
 * themselves, which zip_xy_scaler ignores and zip_temp_layer uses to
 * keep the Mouse layer alive while touching). No zip_button_behaviors
 * here: it would swallow the firmware tap's BTN_0 (see &glidepoint
 * comment); the left pad keeps its instance to stay click-muted.
 *
 * nav_scroll is dual-purpose while Nav (layer 2) is held:
 *   - &zip_raw_touch_scroll marks the scroll context for the raw
 *     touch stream — frames stream with the scroll-mode flag set and the
 *     host (patched LinearMouse fork) synthesizes smooth scrolling with
 *     lift-off momentum from them, suppressing the wheel events below.
 *   - The wheel chain still runs as a standard fallback for hosts
 *     without a stream consumer: REL deltas map to REL_WHEEL, inverted
 *     for natural scrolling and scaled 1:24 for a sane uncooked rate.
 *     (1:24, not the 1:8 tuned on 2026-08-19: that divisor was calibrated
 *     against relative-mode deltas, and the deltas derived from absolute
 *     counts run ~3x larger - the same ratio that took the pointer scaler
 *     from 3:1 to 1:1. The divisor only affects this driverless fallback;
 *     the streamed frames bypass the processor chain entirely and
 *     LinearMouse does its own scaling on them.)
 */
&cirque_rh_listener {
    status = "okay";
    device = <&glidepoint>;
    /* 1:1, not the relative-mode 3x: pointer deltas here are derived from
     * absolute counts (~38/mm) by the touch-stream module, which run larger
     * than the ASIC's relative-mode output that the 3x was tuned for. */
    input-processors = <&zip_xy_scaler 1 1>,
                       <&zip_temp_layer MOUSE_LAYER MOUSE_LAYER_MS>,
                       <&zip_raw_touch_idle_filter>;
    nav_scroll {
        layers = <2>;
        /* Order matters: the mapper rewrites REL_X/REL_Y to REL_WHEEL, so
         * anything after it must target wheel codes (zip_scroll_transform
         * and zip_scroll_scaler do). zip_raw_touch_scroll is a pure
         * pass-through marker; position is irrelevant, but keep it first
         * for visibility. */
        input-processors = <&zip_raw_touch_scroll>,
                           <&zip_xy_to_vscroll_mapper>,
                           <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
                           <&zip_scroll_scaler 1 24>,
                           <&zip_temp_layer MOUSE_LAYER MOUSE_LAYER_MS>,
                           <&zip_raw_touch_idle_filter>;
    };
};
