#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/input_transform.h>

#include "positions_go60.dtsi"
#include "shared.dtsi"

/* ── Go60-specific: custom input processor + trackpad listeners ── */

/ {
    input_processors {
        zip_xy_to_vscroll_mapper: zip_xy_to_vscroll_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_REL>;
            map = <INPUT_REL_X INPUT_REL_WHEEL
                   INPUT_REL_Y INPUT_REL_WHEEL>;
        };

        zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_0 INPUT_BTN_1>;
        };
    };
};

&cirque_lh_listener {
    input-processors = <&zip_xy_scaler 3 1>, <&zip_button_behaviors>;
};

&cirque_rh_listener {
    input-processors = <&zip_xy_scaler 3 1>, <&zip_button_behaviors>;
    nav_scroll {
        layers = <2>;
        input-processors = <&zip_xy_to_vscroll_mapper>, <&zip_xy_scaler 1 16>;
    };
};

/* No &zip_temp_layer here (unlike go60_rh.keymap): the temp-layer
 * processor is only compiled on the central, and this half's listeners
 * are disabled below anyway — the RH central applies it to both pads.
 */

/* Left pad, under Zephyr's in-tree Cirque driver, configured identically
 * to the right pad: absolute mode, 2x sensitivity, lift-off packets. The
 * absolute frames are forwarded to the central over the split link, where
 * the raw_touch_lh node (go60_rh.keymap) streams them as pad-id 1 and
 * derives the pointer deltas.
 *
 * sensitivity "2x" lowers the ADC gain from the stock maximum ("1x" =
 * most sensitive) for parity with the right pad: at max gain the
 * capacitive baseline drifts under sustained touch and shows up as a
 * jumpy cursor. "2x" matches MoErgo's "medium" sensitivity snippet.
 *
 * Tap-to-click and the pad's geometry/orientation live on the
 * raw_touch_lh node on the central, not here. */
&glidepoint {
    /* MoErgo's Go60 board DTS sets these four on &glidepoint under the
     * forked driver's names. Zephyr 3.5's edtlib errors on properties a
     * binding does not declare, so they must be deleted before the
     * in-tree names are set. */
    /delete-property/ dr-gpios;
    /delete-property/ rotate-90;
    /delete-property/ y-invert;
    /delete-property/ no-secondary-tap;

    data-ready-gpios = <&go60_ext 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

    sensitivity = "2x";

    /* Absolute reporting, for the raw touch stream. */
    data-mode = "absolute";

    /* MANDATORY. Written to the Pinnacle's Z_IDLE register; upstream
     * DEFAULTS IT TO 0, which emits no lift-off packets at all - the
     * module would never see a release, so no release frame, no momentum
     * and no tap-to-click. The forked driver hardcoded 3 in absolute
     * mode. */
    idle-packets-count = <3>;

    /* Deliberately NOT setting swap-xy / invert-y (the relative-mode
     * config did). Upstream applies invert-x/invert-y in BOTH modes, so
     * setting invert-y would bake the mirror into the streamed absolute
     * frames. Frames must stay raw: the orientation is declared on
     * raw_touch_lh instead, where the module applies it to the derived
     * pointer deltas and publishes it in the feature report for the
     * host. swap-xy is inert in absolute mode either way. */
};

/* ── Override: left half is now peripheral ── */
/* Forward local trackpad to central via split */
&cirque_split {
    device = <&glidepoint>;
};

/* Disable listeners (central handles all input processing) */
&cirque_lh_listener {
    status = "disabled";
};

&cirque_rh_listener {
    status = "disabled";
};
